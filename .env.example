# ============================================================
# BASEAPP — Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Aplicacao
APP_NAME="SOMASE"
APP_ENV=production
APP_URL=http://localhost
APP_DEBUG=false
SESSION_TIMEOUT=3600

# Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=seuusuario_appfinance
DB_USERNAME=seuusuario_dbuser
DB_PASSWORD=sua_senha_forte

# Seguranca
APP_SECRET=troque_por_uma_chave_aleatoria_de_32_chars

# E-mail (opcional — usado se voce adicionar envio de e-mails ao projeto)
MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@exemplo.com
MAIL_FROM_NAME="SOMASE"

# Armazenamento
UPLOAD_MAX_SIZE=20M

# ============================================================
# CNPJ Lookup — Endpoint centralizado /api/cnpj/{cnpj}
# ============================================================
# Cache: tempo em horas que o resultado fica salvo no banco (padrao: 24h)
CNPJ_CACHE_TTL_HOURS=24

# Rate-limit: maximo de consultas por janela de tempo (por IP)
CNPJ_RATE_LIMIT_MAX=10
CNPJ_RATE_LIMIT_SECS=60

# Ordem de tentativa dos provedores (separados por virgula)
# Opcoes: brasilapi, receitaws, cnpja
# O sistema tenta cada um em ordem e usa o primeiro que responder com sucesso
CNPJ_PROVIDERS=brasilapi,receitaws,cnpja

# Token do CNPJa (apenas se usar este provedor — plano pago)
# Obtenha em: https://cnpja.com
CNPJA_TOKEN=

# ============================================================
# Cadastro, login social e painel administrativo
# ============================================================
# Habilita a tela de cadastro (false esconde o link "Criar conta")
REGISTRATION_ENABLED=true
# Idade minima para se cadastrar (anos)
REGISTRATION_MIN_AGE=18
# Rate-limit de login: tentativas por IP+e-mail e minutos de bloqueio
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Cadastros permitidos por IP a cada hora
REGISTRATION_MAX_PER_HOUR=5

# Google OAuth 2.0 / OpenID Connect
# Crie em https://console.cloud.google.com/apis/credentials
# URI de redirecionamento: https://SEU-DOMINIO/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (Azure AD) / OpenID Connect
# Crie em https://entra.microsoft.com (App registrations)
# URI de redirecionamento: https://SEU-DOMINIO/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common | organizations | consumers | ID do tenant
MICROSOFT_TENANT=common

# Anexos de lançamentos (PDF/foto). Limite em MB (1 a 50).
ATTACHMENT_MAX_MB=10
# OCR alternativo opcional (fallback quando o Tesseract do navegador falha).
# Crie a chave gratuita em https://ocr.space/ocrapi
OCR_SPACE_API_KEY=
# 1 = mais rápido, 2 = mais preciso (padrão)
OCR_SPACE_ENGINE=2

# ============================================================
# Busca de CEP (centros de custo) — sem chave de API
# ============================================================
# Ordem de fallback: ViaCEP -> BrasilAPI -> OpenCEP (padrao).
# Se um provedor falhar ou demorar mais que CEP_TIMEOUT_SECONDS, o proximo responde.
# Pode reordenar/limitar: CEP_PROVIDERS=brasilapi,viacep,opencep
CEP_PROVIDERS=viacep,brasilapi,opencep
# Cache em disco (JSON por CEP) para reduzir latencia e rate-limit.
CEP_CACHE_DIR=storage/cache/cep
# 0 desliga o cache em disco
CEP_CACHE_TTL_DAYS=7
CEP_TIMEOUT_SECONDS=4
